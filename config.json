      "group": "victim",
      "example": "dc01.corp.com",
      "default": ""
    },
    {
      "key": "DOMAIN",
      "label": "AD ドメイン",
      "group": "victim",
      "example": "corp.com",
      "default": ""
    },
    {
      "key": "BASE_DN",
      "label": "ドメインの DN（DOMAIN から自動）",
