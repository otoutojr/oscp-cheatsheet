    {
      "key": "USER",
      "label": "ユーザー名",
      "group": "cred",
      "example": "pete",
      "default": ""
    },
    {
      "key": "PASSWORD",
      "label": "パスワード",
      "group": "cred",
      "example": "Nexus123!",
      "default": "",
      "secret": true
    },
    {
      "key": "HASH",
      "label": "NT ハッシュ",
      "group": "cred",
      "example": "64f12cddaa88057e06a81b54e73b949b",
      "default": "",
      "secret": true
    },
    {
      "key": "URL",
      "label": "対象 URL",
      "group": "other",
      "example": "http://192.168.50.8/",
      "default": ""
    },
    {
      "key": "WORDLIST",
      "label": "辞書ファイル",
      "group": "other",
      "example": "/usr/share/wordlists/rockyou.txt",
      "default": "/usr/share/wordlists/rockyou.txt"
    },
    {
      "key": "FILE",
      "label": "入力ファイル",
      "group": "other",
      "example": "users.txt",
      "default": ""
    },
    {
      "key": "OUTPUT",
      "label": "出力先",
      "group": "other",
      "example": "out",
      "default": ""
    }
  ],
